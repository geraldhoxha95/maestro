{
  "properties": {
    "owner": "tester",
    "run_strategy": "sequential"
  },
  "workflow": {
    "id": "python-file-writer",
    "name": "Python File Writer Workflow",
    "description": "A simple workflow that executes a Python script to write to a file",
    "params": {
      "output_file": {
        "value": "/tmp/maestro_output.txt",
        "type": "STRING"
      }
    },
    "steps": [
      {
        "step": {
          "id": "write-file",
          "type": "kubernetes",
          "transition": {},
          "retry_policy": {
            "error_retry_limit": 0
          },
          "params": {
            "kubernetes": {
              "value": {
                "image": {
                  "value": "python:3.9-slim",
                  "type": "STRING"
                },
                "entrypoint": {
                  "value": "python /workspace/simple_python_script.py ${workflow.params.output_file}",
                  "type": "STRING"
                },
                "volumes": [
                  {
                    "name": "workspace",
                    "hostPath": {
                      "path": "/Users/ghoxha/Documents/projects/maestro"
                    }
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "workspace",
                    "mountPath": "/workspace"
                  }
                ]
              },
              "type": "MAP"
            }
          }
        }
      }
    ]
  }
}