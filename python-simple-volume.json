{
  "properties": {
    "owner": "tester",
    "run_strategy": "sequential"
  },
  "workflow": {
    "id": "python-simple-volume",
    "name": "Python Simple Volume Test",
    "description": "A simple Python workflow",
    "steps": [
      {
        "step": {
          "id": "write-file",
          "type": "kubernetes",
          "transition": {},
          "retry_policy": {
            "error_retry_limit": 0
          },
          "params": {
            "kubernetes": {
              "value": {
                "image": {
                  "value": "python:3.9-slim",
                  "type": "STRING"
                },
                "entrypoint": {
                  "value": "python -c \"import os; from datetime import datetime; timestamp = datetime.now().strftime('%Y-%m-%d %H:%M:%S'); message = f'Hello from Maestro!\\nScript executed at: {timestamp}\\nThis file was created by a Python script in a Maestro workflow.\\nWorkflow execution completed successfully!\\n'; print(message); print('Test completed successfully')\"",
                  "type": "STRING"
                }
              },
              "type": "MAP"
            }
          }
        }
      }
    ]
  }
}