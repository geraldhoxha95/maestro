{
  "properties": {
    "owner": "tester",
    "run_strategy": "sequential"
  },
  "workflow": {
    "id": "simple-python-workflow",
    "name": "Simple Python Workflow",
    "description": "A simple workflow that executes a Python script",
    "steps": [
      {
        "step": {
          "id": "write-file",
          "type": "kubernetes",
          "transition": {},
          "retry_policy": {
            "error_retry_limit": 0
          },
          "params": {
            "kubernetes": {
              "value": {
                "image": {
                  "value": "python:3.9-slim",
                  "type": "STRING"
                },
                "entrypoint": {
                  "value": "python -c \"print('Hello from Maestro workflow!')\"",
                  "type": "STRING"
                }
              },
              "type": "MAP"
            }
          }
        }
      }
    ]
  }
}